@* 1. Directives *@
@page "/teams/listplayersforteams"
@using AppForSEII.Web.API
@using Microsoft.AspNetCore.Authorization
@inject AppForSEIIAPIClient apiservice
@inject TeamStateContainer teamState
@inject NavigationManager navigation
@attribute [Authorize]

<PageTitle>Select Teammates</PageTitle>

<div class="container">
    @* 1. header *@
    <h3>Select Teammates for your team</h3>

    @* 2. Filters *@
    <div class="mb-2">
        <button class="btn btn-sm rounded-pill me-1 @(sportName == null ? "btn-primary" : "btn-outline-secondary")"
                id="sport_All" @onclick="@(() => SelectSport(null))">All</button>
        @foreach (var sport in allSports)
        {
            <button class="btn btn-sm rounded-pill me-1 @(sportName == sport ? "btn-primary" : "btn-outline-secondary")"
                    id="sport_@sport" @onclick="@(() => SelectSport(sport))">@sport</button>
        }
    </div>

    <div class="row mb-3">
        <div class="col-md-3">
            <label for="skill">Min. skill</label>
            <input class="form-control" type="number" id="skill" @bind="skill" />
        </div>
        <div class="col-md-3">
            <label for="minAge">Min. age</label>
            <input class="form-control" type="number" id="minAge" @bind="minAge" />
        </div>
        <div class="col-md-3">
            <label for="maxAge">Max. age</label>
            <input class="form-control" type="number" id="maxAge" @bind="maxAge" />
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <button class="btn btn-primary" id="searchPlayers" @onclick="SearchPlayers">Search</button>
        </div>
    </div>


    <div class="row">
        @* 3a. Results *@
        <div class="col-md-8">
            @if (Players == null || !Players.Any())
            {
                <div class="alert alert-warning" id="noPlayers">There are no players available.</div>
            }
            else
            {
                <h5>@Players.Count players found</h5>
                <div class="row" id="TableOfPlayers">
                    @foreach (var p in Players)
                    {
                        <div class="col-md-6 mb-3">
                            <div class="card h-100" style="min-height: 140px;">
                                <div class="card-body d-flex justify-content-between">
                                    <div>
                                        <h6 class="fw-bold mb-1">@p.Name @p.Surname</h6>
                                        <small class="text-muted d-block mb-2">Age @p.Age</small>
                                        @foreach (var s in p.Sports)
                                        {
                                            <div>
                                                <span class="badge bg-secondary mb-1">@s.SportName (@s.Skill)</span>
                                            </div>
                                        }
                                    </div>
                                    <div>
                                        @if (teamState.IsSelected(p))
                                        {
                                            <span class="badge bg-success" id="playerAdded_@p.Id">Added</span>
                                        }
                                        else
                                        {
                                            <button class="btn btn-primary btn-sm" id="playerToInvite_@p.Id"
                                                    @onclick="@(() => AddPlayer(p))">Invite</button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* 3b. Selected teammates *@
        <div class="col-md-4">
            <h5>Selected teammates (@team.TeamInvitations.Count)</h5>
            @if (!team.TeamInvitations.Any())
            {
                <p class="text-muted" id="noSelectedPlayers">No teammates selected yet.</p>
            }
            @foreach (var invitation in team.TeamInvitations.ToList())
            {
                <button class="btn btn-outline-danger btn-sm mb-1 me-1" id="selectedPlayer_@invitation.UserId"
                        @onclick="@(() => RemovePlayer(invitation))">
                    @invitation.Name @invitation.Surname ✕
                </button>
            }

            @* 4. Actions *@
            <div class="mt-3">
                <button class="btn btn-success" id="confirmTeam" disabled="@(!team.TeamInvitations.Any())"
                        @onclick="ConfirmTeammates">Confirm</button>
            </div>
        </div>
    </div>
</div>

@* 5. C# logic *@
@code {
    private ICollection<ApplicationUserForTeamDTO>? Players { get; set; } = new List<ApplicationUserForTeamDTO>();
    private List<string> allSports = new List<string>();

    private string? sportName;
    private int? skill;
    private int? minAge;
    private int? maxAge;

    protected override async Task OnInitializedAsync()
    {
        await LoadPlayers();

        allSports = Players!
                    .SelectMany(p => p.Sports)
                    .Select(s => s.SportName)
                    .Distinct().OrderBy(s => s).ToList();
    }

    protected async Task LoadPlayers()
    {
        try
        {
            Players = await apiservice.GetUsersForTeamAsync(sportName, skill, minAge, maxAge);
        }
        catch (ApiException)
        {
            Players = new List<ApplicationUserForTeamDTO>();
        }
        StateHasChanged();
    }

    protected async void SearchPlayers()
    {
        await LoadPlayers();
        StateHasChanged();
    }

    private void SelectSport(string? sport)
    {
        sportName = sport;
        SearchPlayers();
    }

    private TeamForCreateDTO team => teamState.Team;

    private void AddPlayer(ApplicationUserForTeamDTO player) => teamState.AddPlayerToTeam(player);

    private void RemovePlayer(TeamInvitationDTO invitation) => teamState.RemovePlayerFromTeam(invitation);

    private void ConfirmTeammates() => navigation.NavigateTo("/teams/createteam");
}